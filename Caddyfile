# TLS terminator for the LAN-only Nextcloud stack.
#
# Everything below the global block MUST live inside a site block. Directives
# at the top level of a Caddyfile are parsed as a *site address*: the earlier
# flat layout made Caddy match only `Host: auto_https` / `Host: off`, so every
# real request fell through all routes and got an empty HTTP 200.
{
	# No ACME, no automatic redirects: the certificate is the self-signed one
	# that `./setup.sh` generates into ./tls (mounted read-only below).
	auto_https off
}

:443 {
	tls /etc/caddy/tls/site.crt /etc/caddy/tls/site.key

	# zstd/br/gzip (Brotli comes from the helixcode-caddy-brotli image).
	encode zstd br gzip

	# Caddy sets X-Forwarded-For/-Proto/-Host itself. Nextcloud honours them
	# because the proxy's address is listed in TRUSTED_PROXIES (compose.yaml).
	reverse_proxy nextcloud-app:80
}
