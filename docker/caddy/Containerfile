# Caddy with Brotli. The stock image only does zstd+gzip, and the Caddyfile
# asks for `encode zstd br gzip`. Built once by `./setup.sh` (ensure_caddy_image)
# and tagged localhost/nextcloud-caddy-brotli:2.
FROM docker.io/library/caddy:2-builder AS builder
RUN xcaddy build --with github.com/ueffel/caddy-brotli

FROM docker.io/library/caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
