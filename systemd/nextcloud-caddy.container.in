# Caddy — TLS terminator (HTTPS + HTTP/3 + Brotli) in front of `app`.
# Runs as container-root, which rootless Podman maps to the invoking user.
[Unit]
Description=Nextcloud — Caddy HTTPS front end
Documentation=file://@PROJECT_DIR@/README.md
Wants=nextcloud-app.service
After=nextcloud-app.service

[Container]
ContainerName=nextcloud-caddy
Image=@CADDY_IMAGE@
# A locally tagged image: never try to pull it from a registry.
Pull=never
Network=nextcloud.network
EnvironmentFile=@PROJECT_DIR@/.run/caddy.env
# HTTPS + HTTP/3 (QUIC); UDP is required for QUIC. auto_https is off, so there
# is no :80 listener.
PublishPort=@BIND@:@HTTPS_PORT@:443/tcp
PublishPort=@BIND@:@HTTPS_PORT@:443/udp
Volume=@PROJECT_DIR@/Caddyfile:/etc/caddy/Caddyfile:ro
# Self-signed certificate + key, generated by `./setup.sh` (ensure_tls).
Volume=@PROJECT_DIR@/tls:/etc/caddy/tls:ro
Volume=nextcloud-caddy-data:/data

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
