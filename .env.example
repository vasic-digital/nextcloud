# ---------------------------------------------------------------------------
#  Template for .env — do NOT put real secrets in this file.
#
#  `./setup.sh` copies this file to .env (mode 0600) and fills in generated
#  passwords, the detected LAN address and the detected timezone. .env is
#  git-ignored. Every value below can be edited by hand afterwards; run
#  `./setup.sh restart` for the changes to take effect.
# ---------------------------------------------------------------------------

# --- network ---------------------------------------------------------------
# Address the web UI is bound to on the host.
#   0.0.0.0       reachable from every machine on your LAN  (default)
#   127.0.0.1     reachable only from this machine
#   192.168.x.y   reachable only on one specific interface
NEXTCLOUD_BIND=0.0.0.0
NEXTCLOUD_PORT=8080

# Space-separated list of host names and IP addresses Nextcloud will answer
# for. Anything not listed here gets "Access through untrusted domain".
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1 nezha

# Base URL used when Nextcloud has to generate links outside a web request
# (notification e-mails, `occ` output, background jobs).
NEXTCLOUD_OVERWRITE_CLI_URL=http://nezha:8080

# --- database --------------------------------------------------------------
DB_NAME=nextcloud
DB_USER=nextcloud
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
# Roughly 25% of the RAM you are willing to give MariaDB. Keep it well under
# the container's memory limit if you set one.
DB_INNODB_BUFFER_POOL=512M

# --- initial administrator account (only used on the very first start) -----
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me
# ISO 3166-1 alpha-2 code used to interpret phone numbers without a country
# prefix. Setting it stops Nextcloud logging warnings on every profile save.
DEFAULT_PHONE_REGION=

# --- PHP and Apache --------------------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=16G
# 0 = no Apache request-body limit. Set a byte value (e.g. 17179869184 for
# 16 GiB) if you would rather have Apache reject oversized uploads outright.
APACHE_BODY_LIMIT=0

# --- misc ------------------------------------------------------------------
TZ=UTC
