# ---------------------------------------------------------------------------
#  Template for .env — do NOT put real secrets in this file.
#
#  `./setup.sh` copies this file to .env (mode 0600) and fills in generated
#  passwords, the detected LAN address and the detected timezone. .env is
#  git-ignored. Every value below can be edited by hand afterwards; run
#  `./setup.sh restart` for the changes to take effect.
# ---------------------------------------------------------------------------

# --- network ---------------------------------------------------------------
# Address BOTH published ports (plain HTTP and HTTPS) are bound to on the host.
# There is no separate HTTP-only bind.
#   0.0.0.0       reachable from every machine on your LAN  (default)
#   127.0.0.1     reachable only from this machine
#   192.168.x.y   reachable only on one specific interface
NEXTCLOUD_BIND=0.0.0.0
# Plain HTTP (Apache).
NEXTCLOUD_PORT=8080
# HTTPS (Caddy, self-signed certificate, HTTP/3). TCP and UDP.
NEXTCLOUD_HTTPS_PORT=52443
# Networks whose X-Forwarded-* headers Nextcloud trusts (Caddy). Leave EMPTY to
# use the subnet Podman actually allocated to the stack's bridge network.
TRUSTED_PROXIES=

# --- storage ---------------------------------------------------------------
# Host directory holding all Nextcloud user files. It is created if missing and
# is owned by YOUR user (the containers run as you via `keep-id`), so it can be
# shared over SMB/NFS. Must be an ABSOLUTE path (setup.sh refuses a relative
# one). ./setup.sh fills in <project>/data by default.
DATA_HOST_PATH=/path/to/nextcloud/data

# Space-separated list of host names and IP addresses Nextcloud will answer
# for. Anything not listed here gets "Access through untrusted domain".
# This is a placeholder: on first run setup.sh fills in this machine's real host
# name and LAN IP.
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1

# Base URL used when Nextcloud has to generate links outside a web request
# (notification e-mails, `occ` output, background jobs). Placeholder: setup.sh
# fills in the real host name on first run, using NEXTCLOUD_PORT's default
# (8080). If you change NEXTCLOUD_PORT later, edit this by hand.
NEXTCLOUD_OVERWRITE_CLI_URL=http://localhost:8080

# --- database --------------------------------------------------------------
# The value `change-me` is a placeholder: setup.sh generates real secrets on
# first run and refuses to start with `change-me` left in place.
DB_NAME=nextcloud
DB_USER=nextcloud
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
# Roughly 25% of the RAM you are willing to give MariaDB. Keep it well under
# the container's memory limit if you set one.
DB_INNODB_BUFFER_POOL=512M

# --- initial administrator account (only used on the very first start) -----
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me
# ISO 3166-1 alpha-2 code used to interpret phone numbers without a country
# prefix. Setting it stops Nextcloud logging warnings on every profile save.
DEFAULT_PHONE_REGION=

# --- PHP and Apache --------------------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=16G
# 0 = no Apache request-body limit. Set a byte value (e.g. 17179869184 for
# 16 GiB) if you would rather have Apache reject oversized uploads outright.
APACHE_BODY_LIMIT=0

# Hour (0-23, UTC) at which Nextcloud runs heavy nightly maintenance.
NEXTCLOUD_MAINTENANCE_WINDOW_START=1

# --- images and service accounts (all optional) -----------------------------
# Override an image reference; empty = the default in setup.sh.
NEXTCLOUD_IMAGE=
DB_IMAGE=
REDIS_IMAGE=
# Caddy is a LOCAL tag, built once from docker/caddy (xcaddy + brotli) and never
# pulled (Pull=never).
CADDY_IMAGE=
# Small image used by backup/restore helpers; empty = docker.io/library/alpine:3.
HELPER_IMAGE=
# The container services run as YOUR user (Podman `keep-id`), mapped from the
# account each image runs as. The uid/gid of that account is read from the image;
# set these only to override the account name or its numeric ids.
APP_RUN_USER=
APP_UID=
APP_GID=
DB_RUN_USER=
DB_UID=
DB_GID=
REDIS_RUN_USER=
REDIS_UID=
REDIS_GID=

# --- misc ------------------------------------------------------------------
TZ=UTC
# (STARTUP_TIMEOUT, seconds to wait for the web UI, default 600, is read from the
# shell environment, not from this file:  STARTUP_TIMEOUT=900 ./setup.sh up)

# --- optional: live SMB test (tests/smb-live-test.sh) ----------------------
# Credentials of the host account that Samba authenticates. Never committed.
SMB_TEST_USER=
SMB_TEST_PASSWORD=
SMB_TEST_SHARE=Nextcloud
# SMB server (default: the LAN IP) and the Nextcloud user whose files are used
# (default: NEXTCLOUD_ADMIN_USER).
SMB_TEST_HOST=
NC_TEST_USER=
